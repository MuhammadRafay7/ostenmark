# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Both are safe to expose to the browser; row-level security is what protects
# the data. The storage hostname for next/image is derived from the URL below,
# so there is no separate image allowlist to keep in sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Canonical site URL (required in production)
# ---------------------------------------------------------------------------
# Drives metadataBase, canonical URLs, sitemap.xml, robots.txt and JSON-LD.
# On Vercel this falls back to the deployment URL, but set it explicitly in
# production or canonical URLs will point at a *.vercel.app domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Inquiry notifications
# ---------------------------------------------------------------------------
# Nothing to configure. Inquiries are saved to Supabase and read at /admin/inbox,
# and the submitter's browser opens a pre-filled mailto: draft addressed to the
# contact email set under /admin/footer, so a copy reaches your mail client
# without any third-party sending service.
