# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Both are safe to expose to the browser; row-level security is what protects
# the data. The storage hostname for next/image is derived from the URL below,
# so there is no separate image allowlist to keep in sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Canonical site URL (required in production)
# ---------------------------------------------------------------------------
# Drives metadataBase, canonical URLs, sitemap.xml, robots.txt and JSON-LD.
# On Vercel this falls back to the deployment URL, but set it explicitly in
# production or canonical URLs will point at a *.vercel.app domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Inquiry notifications (optional)
# ---------------------------------------------------------------------------
# Without these, inquiries are still saved to Supabase and visible at
# /admin/inbox — you just don't get emailed about them. Uses the Resend HTTP API.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=you@your-domain.com
# Must be a sender on a domain verified with Resend. Defaults to Resend's
# onboarding@resend.dev sandbox address if unset.
INQUIRY_NOTIFY_FROM=hello@your-domain.com
