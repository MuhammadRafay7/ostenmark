# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Both are safe to expose to the browser; row-level security is what protects
# the data. The storage hostname for next/image is derived from the URL below,
# so there is no separate image allowlist to keep in sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Canonical site URL (required in production)
# ---------------------------------------------------------------------------
# Drives metadataBase, canonical URLs, sitemap.xml, robots.txt and JSON-LD.
# On Vercel this falls back to the deployment URL, but set it explicitly in
# production or canonical URLs will point at a *.vercel.app domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Email alerts for new inquiries (optional but recommended)
# ---------------------------------------------------------------------------
# Sends "New message on your portfolio — <name>" to your inbox the moment
# someone submits the form. This is plain SMTP against YOUR OWN mailbox — no
# Resend/SendGrid account, no third party holding your leads.
#
# Without these, inquiries are still saved and visible at /admin/inbox; you just
# don't get emailed.
#
# Gmail: you must use an APP PASSWORD, not your account password.
#   Google Account -> Security -> 2-Step Verification -> App passwords.
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
# Outlook / Microsoft 365:  smtp.office365.com   port 587
# Zoho:                     smtp.zoho.com        port 465
# Your own domain host:     see their SMTP settings; 465 or 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello@ostenmark.com
SMTP_PASS=your-16-character-app-password

# Where alerts land. Normally leave this blank: the delivery address is managed
# in the admin at /admin/footer ("Inquiry notifications to"), which falls back to
# the public contact address. This variable is only a fallback for a deploy whose
# CMS row has no address yet; if that is also blank, alerts go to SMTP_USER.
INQUIRY_NOTIFY_TO=
